# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser. Used for rate limiting,
# activity logging, and admin-profile provisioning that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated email(s) that get auto-approved as SUPER_ADMIN on first
# registration, so you have a way into an empty dashboard.
INITIAL_SUPER_ADMIN_EMAILS=you@example.com
